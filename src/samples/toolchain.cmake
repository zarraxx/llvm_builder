list(
    APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    TARGET_TRIPLE
    TARGET_SYSROOT
    SYSROOT_BUNDLE
    SAMPLE_C_COMPILER
    SAMPLE_CXX_COMPILER
)

if(NOT DEFINED TARGET_TRIPLE OR TARGET_TRIPLE STREQUAL "")
    message(FATAL_ERROR "TARGET_TRIPLE is required")
endif()

if(NOT DEFINED TARGET_SYSROOT OR TARGET_SYSROOT STREQUAL "")
    message(FATAL_ERROR "TARGET_SYSROOT is required")
endif()

if(NOT DEFINED SAMPLE_C_COMPILER OR SAMPLE_C_COMPILER STREQUAL "")
    set(SAMPLE_C_COMPILER clang)
endif()

if(NOT DEFINED SAMPLE_CXX_COMPILER OR SAMPLE_CXX_COMPILER STREQUAL "")
    set(SAMPLE_CXX_COMPILER clang++)
endif()

if(TARGET_TRIPLE MATCHES "mingw")
    set(CMAKE_SYSTEM_NAME Windows)
else()
    set(CMAKE_SYSTEM_NAME Linux)
endif()

string(REGEX REPLACE "-.*$" "" TARGET_PROCESSOR "${TARGET_TRIPLE}")
set(CMAKE_SYSTEM_PROCESSOR "${TARGET_PROCESSOR}")

set(CMAKE_C_COMPILER "${SAMPLE_C_COMPILER}")
set(CMAKE_CXX_COMPILER "${SAMPLE_CXX_COMPILER}")
set(CMAKE_C_COMPILER_TARGET "${TARGET_TRIPLE}")
set(CMAKE_CXX_COMPILER_TARGET "${TARGET_TRIPLE}")
set(CMAKE_SYSROOT "${TARGET_SYSROOT}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(SAMPLE_LINKER_FLAGS "-fuse-ld=lld")

# Linux sysroots keep GCC's internal runtime and libstdc++ metadata in the
# common bundle root. Clang's MinGW driver instead finds everything below its
# target sysroot and intentionally ignores --gcc-toolchain.
if(NOT TARGET_TRIPLE MATCHES "mingw")
    if(NOT DEFINED SYSROOT_BUNDLE OR SYSROOT_BUNDLE STREQUAL "")
        message(FATAL_ERROR "SYSROOT_BUNDLE is required for Linux targets")
    endif()

    set(SAMPLE_GCC_TOOLCHAIN "--gcc-toolchain=${SYSROOT_BUNDLE}")
    set(CMAKE_C_FLAGS_INIT "${SAMPLE_GCC_TOOLCHAIN}")
    set(CMAKE_CXX_FLAGS_INIT "${SAMPLE_GCC_TOOLCHAIN}")
    string(APPEND SAMPLE_LINKER_FLAGS " ${SAMPLE_GCC_TOOLCHAIN}")
endif()

set(CMAKE_EXE_LINKER_FLAGS_INIT "${SAMPLE_LINKER_FLAGS}")
